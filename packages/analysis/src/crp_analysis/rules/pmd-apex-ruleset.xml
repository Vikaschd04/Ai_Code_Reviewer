<?xml version="1.0" encoding="UTF-8"?>
<!--
  Trusted refactorX PMD ruleset for Apex (crp-pmd-apex-v1), part of the Salesforce pack.
  Owned by the platform; projects cannot supply or modify it. Rules are PMD built-ins (PMD is
  the engine Salesforce Code Analyzer embeds for Apex); run with the same pinned PMD as Java so
  no rule runs twice. Every enabled rule has an entry in rules/catalog.json and positive and
  negative examples in fixtures/projects/salesforce-mixed.
-->
<ruleset name="crp-pmd-apex-v1"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">
  <description>Apex bulkification, CRUD/FLS and sharing, query injection, callouts, async and test isolation.</description>

  <rule ref="category/apex/performance.xml/OperationWithLimitsInLoop"/>
  <rule ref="category/apex/performance.xml/OperationWithHighCostInLoop"/>
  <rule ref="category/apex/performance.xml/AvoidNonRestrictiveQueries"/>
  <rule ref="category/apex/security.xml/ApexCRUDViolation"/>
  <rule ref="category/apex/security.xml/ApexSharingViolations"/>
  <rule ref="category/apex/security.xml/ApexSOQLInjection"/>
  <rule ref="category/apex/security.xml/ApexSuggestUsingNamedCred"/>
  <rule ref="category/apex/security.xml/ApexInsecureEndpoint"/>
  <rule ref="category/apex/bestpractices.xml/QueueableWithoutFinalizer"/>
  <rule ref="category/apex/bestpractices.xml/ApexUnitTestShouldNotUseSeeAllDataTrue"/>
  <rule ref="category/apex/bestpractices.xml/ApexUnitTestClassShouldHaveAsserts"/>
</ruleset>
