{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crp:schema:fix-export:v1",
  "title": "refactorX fix change summary v1",
  "description": "One fix proposal for one finding: the patch, the exact upload and file it applies to, validation evidence bound to the patch hash, and known risks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "generated_at",
    "tool",
    "project",
    "snapshot",
    "finding",
    "fix",
    "applies_to",
    "validation",
    "labels",
    "known_risks",
    "patch"
  ],
  "properties": {
    "format": {
      "const": "crp-fix-export/v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "component",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "component": {
          "const": "fixes"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "manifest_sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "manifest_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "finding": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "title",
            "engine",
            "rule_id",
            "severity",
            "start_line"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "title": {
              "type": "string"
            },
            "engine": {
              "type": "string"
            },
            "rule_id": {
              "type": "string"
            },
            "severity": {
              "enum": [
                "critical",
                "high",
                "medium",
                "low",
                "info"
              ]
            },
            "start_line": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        }
      ]
    },
    "fix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "recipe_id",
        "title",
        "explanation",
        "behaviour_note",
        "state",
        "path",
        "base_sha256",
        "result_sha256",
        "patch_sha256",
        "changed_lines",
        "edited"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "kind": {
          "enum": [
            "recipe",
            "ai"
          ]
        },
        "recipe_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "explanation": {
          "type": "string"
        },
        "behaviour_note": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "enum": [
            "PROPOSED",
            "VALIDATING",
            "VALIDATED",
            "VALIDATION_FAILED",
            "REJECTED"
          ]
        },
        "path": {
          "type": "string"
        },
        "base_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "result_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "patch_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "changed_lines": {
          "type": "integer",
          "minimum": 0
        },
        "edited": {
          "type": "boolean"
        }
      }
    },
    "applies_to": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id",
        "path",
        "base_sha256",
        "instructions"
      ],
      "properties": {
        "snapshot_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "path": {
          "type": "string"
        },
        "base_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "instructions": {
          "type": "string"
        }
      }
    },
    "validation": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "current",
            "patch_sha256",
            "summary",
            "steps"
          ],
          "properties": {
            "state": {
              "enum": [
                "QUEUED",
                "RUNNING",
                "PASSED",
                "FAILED",
                "CANCELED"
              ]
            },
            "current": {
              "type": "boolean"
            },
            "patch_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "summary": {
              "type": [
                "string",
                "null"
              ]
            },
            "steps": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "label",
                  "state",
                  "detail"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "state": {
                    "enum": [
                      "passed",
                      "failed",
                      "not_run"
                    ]
                  },
                  "detail": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "known_risks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "patch": {
      "type": "string",
      "minLength": 1
    }
  }
}
