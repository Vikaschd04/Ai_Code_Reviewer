{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crp:schema:change-set-export:v1",
  "title": "refactorX fix workspace summary v1",
  "description": "The changes of one fix workspace: the exact upload they apply to, each changed file with its content hashes and provenance, the latest check bound to the same content, and what was not verified.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "generated_at",
    "tool",
    "project",
    "workspace",
    "base",
    "files",
    "deleted",
    "check",
    "not_verified",
    "how_to_apply"
  ],
  "properties": {
    "format": {
      "const": "crp-change-set-export/v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "component",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "component": {
          "const": "workspace"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "content_sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "title": {
          "type": "string"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id",
        "manifest_sha256",
        "name",
        "git_commit",
        "git_ref"
      ],
      "properties": {
        "snapshot_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "manifest_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "git_commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "git_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "action",
          "base_sha256",
          "sha256",
          "sources",
          "flags"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "enum": [
              "modify",
              "add",
              "delete"
            ]
          },
          "base_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "sources": {
            "type": "array",
            "items": {
              "enum": [
                "manual",
                "recipe",
                "ai",
                "revert",
                "export"
              ]
            }
          },
          "flags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "deleted": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checked",
        "state",
        "counts",
        "new_items"
      ],
      "properties": {
        "checked": {
          "type": "boolean",
          "description": "A check of exactly this content exists"
        },
        "state": {
          "type": [
            "string",
            "null"
          ]
        },
        "counts": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "new_items": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "not_verified": {
      "type": "string",
      "minLength": 1
    },
    "how_to_apply": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    }
  }
}
