# Local runtime state: generated secrets, local PostgreSQL/Temporal data, logs, context packets.
.local/
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/

# Node / web
node_modules/
apps/web/dist/
apps/web/playwright-report/
apps/web/test-results/
*.tsbuildinfo

# Build output
dist/

# Editor / OS / tool caches (the .sf directory is a Salesforce extension cache owned by the user)
.DS_Store
.sf/
.sfdx/
.idea/

