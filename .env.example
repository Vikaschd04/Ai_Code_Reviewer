# refactorX settings (CRP_* environment variables). Descriptions only: no usable secrets.
# `make dev` builds these automatically from .local/ and writes .local/dev.env (owner-only, ignored).
# To run a service by hand: set -a; . .local/dev.env; set +a; uv run crp-api

# Deployment tier: local | test. Hosted multi-tenant deployment is not supported before P07.
CRP_ENVIRONMENT=local
# Identity provider: only local_token is implemented. It refuses non-loopback binding.
CRP_AUTH_MODE=local_token
# API bind address/port. Must be loopback (127.0.0.1, ::1 or localhost) in local_token mode.
CRP_API_HOST=127.0.0.1
CRP_API_PORT=8710
# Comma-separated browser origins allowed to make cookie-authenticated state changes (loopback only).
CRP_ALLOWED_WEB_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Absolute path of the generated local API token (owner-only file created by `make bootstrap`).
CRP_LOCAL_TOKEN_FILE=/absolute/path/to/repo/.local/secrets/local-api-token
# Browser session lifetime in seconds (300..604800).
CRP_SESSION_TTL_SECONDS=43200
# Shared demo account: "Try the demo" on the sign-in page opens a separate demo workspace without
# a token. Anyone who can reach the site can use it. Quotas bound its projects and scans.
CRP_DEMO_ENABLED=false
CRP_DEMO_MAX_PROJECTS=30
CRP_DEMO_MAX_SCANS_PER_HOUR=20

# PostgreSQL URL (postgresql+psycopg scheme). The dev password is generated into .local/secrets.
CRP_DATABASE_URL=postgresql+psycopg://crp:<generated-password>@127.0.0.1:55432/crp
CRP_DATABASE_POOL_SIZE=5
CRP_DATABASE_CONNECT_TIMEOUT_SECONDS=5

# Temporal frontend address, namespace and task queue.
CRP_TEMPORAL_ADDRESS=127.0.0.1:7233
CRP_TEMPORAL_NAMESPACE=default
CRP_TEMPORAL_TASK_QUEUE=crp-main
CRP_TEMPORAL_CONNECT_TIMEOUT_SECONDS=5
# A worker counts as ready if it polled within this many seconds.
CRP_WORKER_POLLER_FRESH_SECONDS=90

# Artifact storage for snapshots/raw output/patches. Must be outside the development repository.
CRP_ARTIFACT_BACKEND=filesystem
CRP_ARTIFACT_ROOT=/absolute/path/outside/repo/code-review-platform/artifacts
CRP_ARTIFACT_MAX_OBJECT_BYTES=536870912
# Development repository root; artifact roots inside it are refused.
CRP_TRUSTED_DEV_ROOT=/absolute/path/to/repo

# Intake quotas (development defaults from SOURCE_INTAKE.md; policy limits, not performance promises)
CRP_INTAKE_MAX_UPLOAD_BYTES=104857600
CRP_INTAKE_MAX_EXPANDED_BYTES=1073741824
CRP_INTAKE_MAX_ENTRIES=50000
CRP_INTAKE_MAX_TEXT_FILE_BYTES=10485760
CRP_INTAKE_MAX_COMPRESSION_RATIO=100
CRP_INTAKE_MAX_PATH_LENGTH=1024
CRP_INTAKE_MAX_PATH_DEPTH=64
CRP_INTAKE_CLIENT_MANIFEST_MAX_BYTES=16777216
CRP_INTAKE_EXPIRY_SECONDS=86400

# Analysis execution (worker). Work directories hold read-only snapshot copies; keep them outside the repo.
CRP_WORK_ROOT=/absolute/path/outside/repo/code-review-platform/work
# PMD install (crp-dev sets this to .local/engines/pmd-bin-7.27.0 after `make engines`)
CRP_PMD_HOME=/absolute/path/to/repo/.local/engines/pmd-bin-7.27.0
# Isolated ESLint analyzer package (crp-dev sets this to engines/eslint-runner)
CRP_ESLINT_RUNNER_DIR=/absolute/path/to/repo/engines/eslint-runner
# Optional explicit Node.js executable for the ESLint runner (default: node on PATH)
# CRP_NODE_EXECUTABLE=/opt/homebrew/bin/node
CRP_ENGINE_TIMEOUT_SECONDS=900
CRP_ENGINE_MAX_OUTPUT_BYTES=67108864
CRP_PMD_JAVA_HEAP=1g
CRP_STRUCTURE_MAX_SYMBOLS_PER_FILE=2000

CRP_READINESS_CHECK_TIMEOUT_SECONDS=3
CRP_LOG_LEVEL=INFO
# json | text
CRP_LOG_FORMAT=json

# GitHub (optional, P06; docs/GITHUB.md). Your own GitHub App; secrets only here or in
# owner-only files (the *_FILE variants), never in the repository.
# CRP_GITHUB_APP_ID=123456
# CRP_GITHUB_CLIENT_ID=Iv23li...
# CRP_GITHUB_CLIENT_SECRET_FILE=/abs/path/github-client-secret
# CRP_GITHUB_PRIVATE_KEY_FILE=/abs/path/github-app.pem
# CRP_GITHUB_WEBHOOK_SECRET_FILE=/abs/path/github-webhook-secret
# CRP_GITHUB_APP_SLUG=refactorx-for-acme
# CRP_GITHUB_MAX_BLOB_FETCHES=300
# CRP_GIT_RECONCILE_DAYS=7

# Fix workspaces (P08)
# CRP_CHANGE_SET_MAX_FILES=500
# CRP_AI_FIX_MAX_CANDIDATES=3

# Tool overrides for crp-dev (optional)
# CRP_PG_BIN_DIR=/opt/homebrew/opt/postgresql@18/bin
# CRP_TEMPORAL_CLI=/opt/homebrew/bin/temporal
# CRP_DEV_PG_PORT=55432
# CRP_DEV_TEMPORAL_PORT=7233
# CRP_DEV_TEMPORAL_UI_PORT=8233
# CRP_DEV_API_PORT=8710
# CRP_DEV_WEB_PORT=5173
# CRP_E2E_CHANNEL=chrome   (empty string = Playwright bundled Chromium)
